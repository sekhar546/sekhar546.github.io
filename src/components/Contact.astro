---
import { resume } from "../data/resume";
---

<section id="contact" class="py-20 bg-surface/30">
  <div class="max-w-5xl mx-auto px-4">
    <div class="text-center mb-12">
      <p class="text-primary font-heading text-sm tracking-widest uppercase mb-2">Connect</p>
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-white">Get in Touch</h2>
    </div>

    <div class="grid md:grid-cols-3 gap-6 max-w-3xl mx-auto">
      <a href={`mailto:${resume.email}`} class="group bg-surface-light rounded-xl p-6 border border-border hover:border-primary/20 transition-all glow-border text-center">
        <div class="w-10 h-10 mx-auto mb-3 rounded-lg bg-primary/10 flex items-center justify-center group-hover:bg-primary/20 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </div>
        <h3 class="font-heading font-semibold text-white mb-1">Email</h3>
        <p class="text-text-dim text-sm">{resume.email}</p>
      </a>

      <a href={`tel:${resume.phone}`} class="group bg-surface-light rounded-xl p-6 border border-border hover:border-primary/20 transition-all glow-border text-center">
        <div class="w-10 h-10 mx-auto mb-3 rounded-lg bg-primary/10 flex items-center justify-center group-hover:bg-primary/20 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </div>
        <h3 class="font-heading font-semibold text-white mb-1">Phone</h3>
        <p class="text-text-dim text-sm">{resume.phone}</p>
      </a>

      <a href={resume.linkedin} target="_blank" rel="noopener" class="group bg-surface-light rounded-xl p-6 border border-border hover:border-primary/20 transition-all glow-border text-center">
        <div class="w-10 h-10 mx-auto mb-3 rounded-lg bg-primary/10 flex items-center justify-center group-hover:bg-primary/20 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </div>
        <h3 class="font-heading font-semibold text-white mb-1">LinkedIn</h3>
        <p class="text-text-dim text-sm">{resume.location}</p>
      </a>
    </div>
  </div>
</section>