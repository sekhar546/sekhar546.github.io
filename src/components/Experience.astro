---
import { resume } from "../data/resume";
---

<section id="experience" class="py-20">
  <div class="max-w-5xl mx-auto px-4">
    <div class="text-center mb-12">
      <p class="text-primary font-heading text-sm tracking-widest uppercase mb-2">Career</p>
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-white">Experience</h2>
    </div>

    <div class="relative">
      <div class="hidden md:block absolute top-6 left-0 right-0 h-px bg-border" />

      <div class="flex flex-col md:flex-row md:gap-6">
        {resume.experience.map((exp, i) => (
          <div class="relative flex-1 mb-10 md:mb-0 md:min-w-0">
            <div class="hidden md:flex justify-center mb-6">
              <div class="w-4 h-4 rounded-full bg-primary border-2 border-surface-dark z-10" />
            </div>

            <div class="md:hidden absolute left-0 top-1 bottom-0 w-px bg-border" />
            <div class="md:hidden absolute left-[-0.35rem] top-1 w-3 h-3 rounded-full bg-primary border-2 border-surface-dark z-10" />

            <div class="md:mx-1 pl-6 md:pl-0">
              <div class="bg-surface-light rounded-xl p-5 border border-border hover:border-primary/20 transition-all glow-border group h-full">
                <div class="flex flex-wrap items-baseline gap-x-2 mb-1">
                  <h3 class="font-heading font-semibold text-sm text-white group-hover:text-primary transition-colors">
                    {exp.title}
                  </h3>
                  <span class="text-primary text-xs font-medium">{exp.company}</span>
                </div>
                <div class="flex items-center gap-2 text-text-dim text-xs mb-3">
                  <span>{exp.location}</span>
                  <span class="w-1 h-1 rounded-full bg-text-dim" />
                  <span>{exp.period}</span>
                </div>
                <div class="flex flex-wrap gap-1 mb-3">
                  {exp.tags.slice(0, 4).map((tag) => (
                    <span class="px-2 py-0.5 text-[10px] font-medium rounded-full bg-primary/10 text-primary border border-primary/20">
                      {tag}
                    </span>
                  ))}
                </div>
                <p class="text-text-muted text-xs leading-relaxed line-clamp-2">
                  {exp.achievements[0]}
                </p>
                <details class="mt-2">
                  <summary class="text-xs text-primary cursor-pointer hover:text-primary-light transition-colors list-none flex items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
                    <span class="toggle-label">Show {exp.achievements.length - 1} more</span>
                  </summary>
                  <ul class="space-y-1.5 mt-2">
                    {exp.achievements.slice(1).map((a) => (
                      <li class="flex gap-2 text-xs text-text-muted">
                        <span class="text-primary mt-0.5 flex-shrink-0">
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                        </span>
                        <span>{a}</span>
                      </li>
                    ))}
                  </ul>
                </details>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll("#experience details").forEach((details) => {
    details.addEventListener("toggle", () => {
      const label = details.querySelector(".toggle-label");
      const svg = details.querySelector("summary svg");
      if (details.open) {
        if (label) label.textContent = "Show less";
        if (svg) svg.style.transform = "rotate(180deg)";
      } else {
        if (label) label.textContent = label.textContent.replace("Show less", "Show more");
        if (svg) svg.style.transform = "rotate(0deg)";
      }
    });
  });
</script>