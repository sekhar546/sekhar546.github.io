---
import { resume } from "../data/resume";
---

<section id="experience" class="py-20">
  <div class="max-w-5xl mx-auto px-4">
    <div class="text-center mb-12">
      <p class="text-primary font-heading text-sm tracking-widest uppercase mb-2">Career</p>
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-heading">Experience</h2>
    </div>

    <div class="relative pl-10 md:pl-0">
      <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-px bg-border md:-translate-x-px" />

      {resume.experience.map((exp, i) => (
        <div class={`relative mb-10 md:flex md:items-start md:gap-12 ${i % 2 === 0 ? "" : "md:flex-row-reverse"}`}>
          <div class="hidden md:block md:flex-1" />

          <div class="absolute left-[-1.1rem] md:left-1/2 md:-translate-x-1/2 top-1 w-3.5 h-3.5 rounded-full bg-primary border-[3px] border-surface-dark shadow-[0_0_0_2px_rgba(6,182,212,0.3)] z-10" />

          <div class="md:flex-1">
            <div class="bg-surface-light rounded-xl p-5 border border-border hover:border-primary/20 transition-all duration-300 glow-border group md:mt-2">
              <div class="flex items-start justify-between gap-2 mb-2">
                <div>
                  <h3 class="font-heading font-semibold text-heading group-hover:text-primary transition-colors">
                    {exp.title}
                  </h3>
                  <p class="text-primary text-sm font-medium">{exp.company}</p>
                </div>
              </div>
              <div class="flex items-center gap-2 text-text-dim text-xs mb-3">
                <span>{exp.location}</span>
                <span class="w-1 h-1 rounded-full bg-text-dim" />
                <span>{exp.period}</span>
              </div>
              <div class="flex flex-wrap gap-1.5 mb-3">
                {exp.tags.map((tag) => (
                  <span class="px-2 py-0.5 text-[10px] font-medium rounded-full bg-primary/10 text-primary border border-primary/20">
                    {tag}
                  </span>
                ))}
              </div>
              <ul class="space-y-2">
                {exp.achievements.slice(0, 3).map((a) => (
                  <li class="flex gap-2 text-sm text-text-muted">
                    <span class="text-primary mt-1 flex-shrink-0">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    </span>
                    <span>{a}</span>
                  </li>
                ))}
              </ul>
              {exp.achievements.length > 3 && (
                <details class="mt-2">
                  <summary class="text-xs text-primary cursor-pointer hover:text-primary-light transition-colors list-none flex items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
                    <span class="toggle-label">Show {exp.achievements.length - 3} more</span>
                  </summary>
                  <ul class="space-y-2 mt-2">
                    {exp.achievements.slice(3).map((a) => (
                      <li class="flex gap-2 text-sm text-text-muted">
                        <span class="text-primary mt-1 flex-shrink-0">
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                        </span>
                        <span>{a}</span>
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  try {
    document.querySelectorAll("#experience details").forEach((details) => {
      details.addEventListener("toggle", () => {
        try {
          const label = details.querySelector(".toggle-label");
          const svg = details.querySelector("summary svg");
          if (details.open) {
            if (label) label.textContent = "Show less";
            if (svg) svg.style.transform = "rotate(180deg)";
          } else {
            if (label) label.textContent = label.textContent?.replace("Show less", "Show more") ?? "Show more";
            if (svg) svg.style.transform = "rotate(0deg)";
          }
        } catch (e) {
          console.warn("Experience toggle error:", e);
        }
      });
    });
  } catch (e) {
    console.warn("Experience init failed:", e);
  }
</script>