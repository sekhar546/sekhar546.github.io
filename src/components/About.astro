---
import { resume } from "../data/resume";
---

<section id="about" class="py-20">
  <div class="max-w-5xl mx-auto px-4">
    <div class="text-center mb-12">
      <div class="flex items-center gap-3 justify-center mb-3">
        <div style="width:28px;height:2px;background:linear-gradient(90deg,#00F5FF,#FF0090);border-radius:1px;box-shadow:0 0 8px rgba(0,245,255,0.4);"></div>
        <p style="font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:3px;text-transform:uppercase;color:#00F5FF;">// About</p>
        <div style="width:28px;height:2px;background:linear-gradient(90deg,#FF0090,#00F5FF);border-radius:1px;box-shadow:0 0 8px rgba(0,245,255,0.4);"></div>
      </div>
      <h2 class="font-heading text-3xl md:text-4xl font-bold" style="color:#DDEEFF;">Background</h2>
    </div>

    <div class="grid md:grid-cols-5 gap-8 items-start">
      <div class="md:col-span-2 flex justify-center">
        <div class="w-48 h-48 md:w-56 md:h-56 rounded-full overflow-hidden" style="border:1px solid rgba(0,245,255,0.25);box-shadow:0 0 30px rgba(0,245,255,0.12),0 0 60px rgba(0,245,255,0.05);">
          <img src="/assets/profile.webp" alt={resume.name} width="224" height="224" class="w-full h-full object-cover object-center-top" loading="lazy" />
        </div>
      </div>

      <div class="md:col-span-3 space-y-4">
        {resume.summary.map((p) => (
          <p class="text-text-muted leading-relaxed">{p}</p>
        ))}

        <div class="flex flex-wrap gap-4 pt-4">
          {[
            { label: "Healthcare" },
            { label: "Insurance" },
            { label: "Banking" },
            { label: "HIPAA Compliant" },
          ].map((domain) => (
            <span style="font-family:'JetBrains Mono',monospace;font-size:9px;font-weight:600;letter-spacing:1.2px;text-transform:uppercase;padding:4px 12px;border-radius:20px;background:rgba(0,245,255,0.08);color:#00F5FF;border:1px solid rgba(0,245,255,0.2);">
              {domain.label}
            </span>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-16 bg-surface-light rounded-xl p-6 md:p-8 border border-border">
      <h3 class="font-heading text-lg font-semibold text-heading mb-4 text-center">Pipeline Architecture Vision</h3>
      <div class="flex flex-wrap items-center justify-center gap-3 md:gap-6 text-xs md:text-sm">
        {[
          { label: "Sources", icon: "📡", color: "text-yellow-400" },
          { label: "Ingestion", icon: "⬇️", color: "text-primary" },
          { label: "Processing", icon: "⚙️", color: "text-violet" },
          { label: "Storage", icon: "💾", color: "text-accent" },
          { label: "Analytics", icon: "📊", color: "text-orange-400" },
        ].map((layer, i, arr) => (
          <>
            <div class="flex flex-col items-center gap-1">
              <span class={layer.color + " text-xl"}>{layer.icon}</span>
              <span class="font-heading text-text-muted whitespace-nowrap">{layer.label}</span>
            </div>
            {i < arr.length - 1 && (
              <div class="hidden md:block w-8 h-px bg-border-light mt-5" />
            )}
          </>
        ))}
      </div>
    </div>
  </div>
</section>