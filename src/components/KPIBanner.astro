---
export const prerender = true;
---

<section class="py-12 bg-surface/50">
  <div class="max-w-5xl mx-auto px-4">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
      {[
        { label: "Years Experience", value: "14+" },
        { label: "Cost Savings", value: "$50K/mo" },
        { label: "Records Processed", value: "10M+" },
        { label: "Projects Delivered", value: "20+" },
      ].map((stat, i) => (
        <div
          class="stat-card p-4 md:p-6 rounded-xl bg-surface-light border border-border text-center hover:border-primary/20 transition-colors"
          style={`animation-delay: ${i * 100}ms`}
        >
          <div
            class="text-2xl md:text-3xl font-heading font-bold gradient-text stat-value"
            data-target={stat.value.replace(/[^0-9]/g, "")}
            data-suffix={stat.value.replace(/[0-9]/g, "")}
          >
            {stat.value}
          </div>
          <p class="text-text-dim text-sm mt-1">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stat-card {
    opacity: 0;
    animation: slideUp 0.5s ease-out forwards;
  }
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>