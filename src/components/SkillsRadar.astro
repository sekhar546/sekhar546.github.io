---
import { resume } from "../data/resume";

const radarLabels = ["Cloud", "Warehousing", "ETL / Pipelines", "Streaming", "Governance", "AI / ML"];

function computeRadarData() {
  const groups = { ...resume.skills };
  const cloudScores = groups["Cloud & Data Platforms"]?.map((s) => s.level) ?? [];
  const engScores = groups["Data Engineering & AI"]?.map((s) => s.level) ?? [];

  const avg = (arr) => Math.round(arr.reduce((a, b) => a + b, 0) / arr.length);

  return [
    avg(cloudScores),
    avg([cloudScores[2] ?? 0, cloudScores[3] ?? 0]),
    avg([...cloudScores, ...engScores]),
    cloudScores[0] ?? 4,
    cloudScores[4] ?? 4,
    engScores[4] ?? 3,
  ];
}

const radarData = computeRadarData();
---

<section id="skills" class="py-20">
  <div class="max-w-5xl mx-auto px-4">
    <div class="text-center mb-12">
      <p class="text-primary font-heading text-sm tracking-widest uppercase mb-2">Expertise</p>
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-heading">Technical Skills</h2>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      {Object.entries(resume.skills).map(([groupName, skills]) => (
        <div class="bg-surface-light rounded-xl p-6 border border-border">
          <h3 class="font-heading font-semibold text-primary mb-5 text-center">{groupName}</h3>
          <div class="space-y-4">
            {skills.map((skill) => (
              <div>
                <div class="flex justify-between text-sm mb-1.5">
                  <span class="text-heading font-medium">{skill.name}</span>
                  <span class="text-text-dim">{skill.level}/5</span>
                </div>
                <div class="h-1.5 rounded-full bg-surface-dark overflow-hidden">
                  <div
                    class="h-full rounded-full bg-gradient-to-r from-primary to-violet skill-bar"
                    style={`width: 0%`}
                    data-width={skill.level * 20}
                  />
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="mt-12 bg-surface-light rounded-xl p-6 border border-border max-w-md mx-auto">
      <h3 class="font-heading font-semibold text-heading mb-4 text-center">Skills Radar</h3>
      <canvas id="skillsRadar" width="400" height="400" class="max-w-xs mx-auto" data-radar={JSON.stringify(radarData)}></canvas>
    </div>
  </div>
</section>

<script>
  (() => {
    try {
      const canvas = document.getElementById("skillsRadar");
      if (!canvas || typeof Chart === "undefined") {
        if (typeof Chart === "undefined") console.warn("Chart.js not loaded");
        return;
      }

      const data = JSON.parse(canvas.dataset.radar);

    new Chart(canvas, {
      type: "radar",
      data: {
        labels: ["Cloud", "Warehousing", "ETL / Pipelines", "Streaming", "Governance", "AI / ML"],
        datasets: [{
          label: "Proficiency",
          data,
          backgroundColor: "rgba(6, 182, 212, 0.1)",
          borderColor: "#06b6d4",
          borderWidth: 2,
          pointBackgroundColor: "#06b6d4",
          pointBorderColor: "#12122a",
          pointBorderWidth: 2,
          pointRadius: 4,
        }],
      },
      options: {
        responsive: true,
        maintainAspectRatio: true,
        scales: {
          r: {
            beginAtZero: true,
            max: 5,
            ticks: { stepSize: 1, color: "#64748b", backdropColor: "transparent" },
            grid: { color: "rgba(148, 163, 184, 0.1)" },
            angleLines: { color: "rgba(148, 163, 184, 0.1)" },
            pointLabels: { color: "#94a3b8", font: { family: "'JetBrains Mono', monospace", size: 11 } },
          },
        },
        plugins: {
          legend: { display: false },
        },
      },
    });

    const skillBars = document.querySelectorAll(".skill-bar");
    const barObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const w = parseInt(entry.target.dataset.width);
            entry.target.style.transition = "width 1s ease-out";
            entry.target.style.width = w + "%";
            barObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.3 }
    );
    skillBars.forEach((bar) => barObserver.observe(bar));
    } catch (e) {
      console.warn("Skills radar init failed:", e);
    }
  })();
</script>